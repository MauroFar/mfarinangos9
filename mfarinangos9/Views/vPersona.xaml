<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mfarinangos9.Views.vPersona"
             Title="vPersona">
    <VerticalStackLayout
        Padding="30"
        Spacing="25">
        
        
        <Label 
            Text="Semana 6 Bases de datos locales"
            FontSize="20"
            
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Entry x:Name="txtName" Placeholder="Ingresa tu nombre"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnAgregar"
                Text="Agregar persona"
                Grid.Row="0"
                Grid.Column="0"
                    
                Clicked="btnAgregar_Clicked"/>
            <Label x:Name="lblStatusMessage"
                Text=""
                Grid.Row="1"
                Grid.Column="0"
                VerticalOptions="Center"
                HorizontalOptions="Center"/>
            <Button x:Name="btnMostrar"
                Text="Listar personas"
                Grid.Row="2"
                Grid.Column="0"
                Clicked="btnListar_Clicked"/>
            
            <CollectionView x:Name="ListaPersonas"
                Grid.Row="3"
                Grid.Column="0">
                <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="{Binding Id}" Grid.Row="0" Grid.Column="0" VerticalOptions="Center"/>
                        <Label Text="{Binding Name}" Grid.Row="0" Grid.Column="1" VerticalOptions="Center"/>
                        <Button Text="Eliminar"
                                Grid.Row="0"
                                Grid.Column="2"
                                BindingContext="{Binding .}"
                                Clicked="btnEliminar_Clicked"/>
                    </Grid>
                </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </VerticalStackLayout>
</ContentPage>